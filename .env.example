APP_NAME=Laravel
# PRODUCTION CHECKLIST: APP_ENV=production, APP_DEBUG=false, APP_URL=https://...,
# SESSION_SECURE_COOKIE=true, SESSION_ENCRYPT=true. With APP_ENV=production the
# app forces https URLs (AppServiceProvider). Keep these as-is for local dev.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# A reverse proxy or HTTPS tunnel in front of the app (comma-separated IPs).
# 127.0.0.1 when testing the student app on a phone through Cloudflare Tunnel
# on this computer. Leave blank when there is none.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chrisduran
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Leave unset for local HTTP development - the browser will silently refuse
# to send the session cookie back over plain HTTP if this is true, which
# breaks login. Once deployed behind real HTTPS, set this to true so the
# session cookie is never sent over an unencrypted connection.
SESSION_SECURE_COOKIE=null

# Data retention (days) - see config/retention.php and `php artisan logs:prune`
ACTIVITY_LOG_RETENTION_DAYS=730
HELP_BOT_LOG_RETENTION_DAYS=180

# Privacy notice (see config/privacy.php). Bump the version to make every
# user acknowledge the notice again after you change its wording.
PRIVACY_NOTICE_VERSION=2026-09-30
PRIVACY_DPO_NAME=
PRIVACY_CONTACT_EMAIL=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------- OCR / PDF tools ----------------
# Absolute paths on Windows/XAMPP (Apache won't pick up a PATH change without a restart).
OCR_TESSERACT_PATH=tesseract
OCR_PDFTOTEXT_PATH=pdftotext
OCR_PDFTOPPM_PATH=pdftoppm
OCR_PDFINFO_PATH=pdfinfo
OCR_PDFSEPARATE_PATH=pdfseparate
OCR_PDFUNITE_PATH=pdfunite
# ZBar - optional, only for barcode separator-sheet detection. Falls back to blank-page detection if absent.
OCR_ZBARIMG_PATH=zbarimg

# ---------------- Scan inbox (Digitize Hardcopy) ----------------
# Folder the scanner software drops finished PDFs into.
SCAN_INBOX_PATH=
SCAN_MAX_PER_RUN=10
SCAN_STABLE_SECONDS=15
SCAN_MAX_PAGES=200
SCAN_THUMB_DPI=120
SCAN_OCR_DPI=200
SCAN_PROCESS_TIMEOUT=240
SCAN_BARCODE_SEPARATION=true
SCAN_BARCODE_TOKEN=DOCSPLIT
SCAN_BLANKPAGE_SEPARATION=true
SCAN_BLANK_INK_THRESHOLD=0.004
SCAN_BATCH_RETENTION_DAYS=30

# ---------------- Backup encryption ----------------
# Password backup ZIPs are AES-256 encrypted with. Generate with e.g.:
#   php -r "echo bin2hex(random_bytes(32));"
# No key = no backup (createBackup() hard-fails rather than write one
# unencrypted). Store this somewhere outside .env too (password manager/
# safe) - if it's lost, every existing backup ZIP is unreadable forever.
BACKUP_ENCRYPTION_KEY=

# ---------------- Help assistant (Google Gemini) ----------------
# Get a key at https://aistudio.google.com/apikey . Leave blank to disable
# the chat widget (it hides itself when no key is configured).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

VITE_APP_NAME="${APP_NAME}"

# Browser push for the public student page. Generate with: php artisan webpush:vapid
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
# Contact for the push services (mailto: or https:). Defaults to MAIL_FROM_ADDRESS.
WEBPUSH_VAPID_SUBJECT=

# Backblaze B2 - off-site copy of the backup ZIPs (see config/filesystems.php "backups").
# Bucket page shows the endpoint, e.g. s3.us-west-004.backblazeb2.com -> region us-west-004.
# Use an application key limited to this one bucket (Read and Write), never the master key.
BACKUP_B2_KEY_ID=
BACKUP_B2_APPLICATION_KEY=
BACKUP_B2_BUCKET=
BACKUP_B2_REGION=
BACKUP_B2_ENDPOINT=
