* text=auto eol=lf
# Windows scripts (services, start-all) keep CRLF on checkout: cmd.exe can
# misread labels and GOTO in a batch file saved with LF only.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
